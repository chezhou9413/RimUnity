<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>../../1.7/Assemblies/</OutputPath>
    <AssemblyName>RimUnity.Spine</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../RimUnity/RimUnity.csproj" /></ItemGroup>
  <Target Name="BuildEmbeddedRuntime" AfterTargets="Build" Condition="'$(SkipEmbedded)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../Tools/Build-Embedded.ps1&quot; -GameRoot &quot;$(RimWorldDir)&quot; -HarmonyPath &quot;$(HarmonyPath)&quot;" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
  </Target>
</Project>
