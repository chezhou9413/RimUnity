<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>../../1.7/Assemblies/</OutputPath><OutputPath Condition="'$(RimUnityParticleAnalysis)' == 'true'">$(ParticleAnalysisRoot)/Assemblies/</OutputPath>
    <AssemblyName>RimUnity.Spine</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../RimUnity/RimUnity.csproj" /></ItemGroup>
  <Target Name="BuildEmbeddedRuntime" AfterTargets="Build" Condition="'$(SkipEmbedded)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../Tools/Build/RimUnity.Build.csproj&quot; --configuration Release -- embedded --game &quot;$(RimWorldDir)&quot; --harmony &quot;$(HarmonyPath)&quot; --runtime &quot;$(TargetDir).&quot;" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
  </Target>
</Project>
