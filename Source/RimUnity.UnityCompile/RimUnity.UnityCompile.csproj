<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>9.0</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityEditorDir Condition="'$(UnityEditorDir)' == ''">$(UNITY_EDITOR_DIR)</UnityEditorDir>
    <UnityProject Condition="'$(UnityProject)' == ''">$(UNITY_PROJECT)</UnityProject>
    <OutputPath Condition="'$(OutputPath)' == ''">$(TEMP)/RimUnity/UnityCompile/</OutputPath>
    <DefineConstants>UNITY_EDITOR;UNITY_2022_3_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityPackage/Runtime/**/*.cs;../../UnityPackage/Editor/**/*.cs" />
    <Reference Include="$(UnityEditorDir)/Managed/UnityEngine/*.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(UnityEditorDir)/Managed/Newtonsoft.Json.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(UnityProject)/Library/ScriptAssemblies/Unity.TextMeshPro.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(UnityProject)/Library/ScriptAssemblies/UnityEngine.UI.dll" />
  </ItemGroup>
</Project>
