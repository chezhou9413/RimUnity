<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputPath>../../1.7/Assemblies/</OutputPath><AssemblyName>RimUnity</AssemblyName><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimUnity.Core/RimUnity.Core.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" />
    <Reference Include="Waylith" HintPath="$(RimWorldDir)/Waylith.dll" />
    <Reference Include="0Harmony" HintPath="$(HarmonyPath)" />
    <Reference Include="Brutal.ImGui" HintPath="$(RimWorldDir)/Brutal.ImGui.dll" />
    <Reference Include="Brutal.Core.Numerics" HintPath="$(RimWorldDir)/Brutal.Core.Numerics.dll" />
    <Reference Include="Brutal.Core.Common" HintPath="$(RimWorldDir)/Brutal.Core.Common.dll" />
    <Reference Include="Brutal.Core.Memory" HintPath="$(RimWorldDir)/Brutal.Core.Memory.dll" />
    <Reference Include="Brutal.Vulkan.Vma" HintPath="$(RimWorldDir)/Brutal.Vulkan.Vma.dll" />
    <Reference Include="Brutal.Vulkan" HintPath="$(RimWorldDir)/Brutal.Vulkan.dll" />
    <Reference Include="Brutal.Vulkan.Abstractions" HintPath="$(RimWorldDir)/Brutal.Vulkan.Abstractions.dll" />
    <Compile Include="../../UnityPackage/Runtime/Serialization/*.cs" Link="Serialization/%(Filename)%(Extension)" />
    <Compile Include="../Shared/ShaderColorSpace.cs" Link="Rendering/ShaderColorSpace.cs" />
  </ItemGroup>
</Project>

