<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UnityEditorDir Condition="'$(UnityEditorDir)' == ''">$(UNITY_EDITOR_DIR)</UnityEditorDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityPackage/Editor/Export/ExportStorage.cs" Link="ExportStorage.cs" />
    <Compile Include="../../UnityPackage/Editor/Export/ExportSharing.cs" Link="ExportSharing.cs" />
    <Compile Include="../../UnityPackage/Editor/Export/ExportJson.cs" Link="ExportJson.cs" />
    <Compile Include="../../UnityPackage/Runtime/Serialization/ContentFiles.cs" Link="ContentFiles.cs" />
    <Reference Include="Newtonsoft.Json" HintPath="$(UnityEditorDir)/Managed/Newtonsoft.Json.dll" />
  </ItemGroup>
</Project>
