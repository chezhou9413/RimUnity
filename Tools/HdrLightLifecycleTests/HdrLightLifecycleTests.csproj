<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(TestTargetFramework)' != ''">$(TestTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <HdrSourceRoot Condition="'$(HdrSourceRoot)' == ''">../../Source/RimUnity/Rendering/Hdr</HdrSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HdrSourceRoot)/HdrMapHooks.cs" Link="Runtime/HdrMapHooks.cs" />
    <Compile Include="$(HdrSourceRoot)/HdrLightTarget.cs" Link="Runtime/HdrLightTarget.cs" />
    <Compile Include="$(HdrSourceRoot)/HdrDrawTarget.Pass.cs" Link="Runtime/HdrDrawTarget.Pass.cs" />
    <Compile Include="$(HdrSourceRoot)/HdrLightFrame.cs" Link="Runtime/HdrLightFrame.cs" />
    <Compile Include="$(HdrSourceRoot)/HdrLightBlend.cs" Link="Runtime/HdrLightBlend.cs" />
    <Compile Include="../../Source/RimUnity/Diagnostics/RenderTraceBuffer.cs" Link="Runtime/RenderTraceBuffer.cs" />
    <Compile Include="../../Source/RimUnity/Diagnostics/RenderDebugReport.Hdr.cs" Link="Runtime/RenderDebugReport.Hdr.cs" />
  </ItemGroup>
</Project>
